<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>{% block title %}Admin{% endblock %} · Portfolio Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{ asset('admin.css') }}">
  <link rel="stylesheet" href="{{ asset('admin-extra.css') }}">
  {# Éditeur Markdown (EasyMDE, licence MIT) pour les descriptions détaillées #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css">
</head>
<body>
{% block body %}
{% set current = app.request.attributes.get('section') ?? app.request.attributes.get('_route') %}
<div id="adminPanel" class="page admin-layout active">
  <aside class="sidebar">
    <div class="sidebar__top">
      <a class="sidebar-brand" href="{{ path('admin_dashboard') }}">
        <span class="sidebar-brand__icon"><i class="bi bi-code-square"></i></span>
        <span class="sidebar-brand__text">Portfolio</span>
      </a>
    </div>
    <nav class="sidebar__nav">
      <div class="nav-group">
        <span class="nav-group__label">Général</span>
        <a class="nav-item{{ current == 'admin_dashboard' ? ' active' }}" href="{{ path('admin_dashboard') }}"><i class="bi bi-grid-1x2"></i><span>Tableau de bord</span></a>
        <a class="nav-item{{ current == 'admin_portfolio' ? ' active' }}" href="{{ path('admin_portfolio') }}"><i class="bi bi-person-circle"></i><span>Mon profil</span></a>
        <a class="nav-item" href="{{ path('home') }}" target="_blank"><i class="bi bi-box-arrow-up-right"></i><span>Voir le site</span></a>
      </div>
      <div class="nav-group">
        <span class="nav-group__label">Gestion</span>
        {% for slug, s in admin_sections() %}
          <a class="nav-item{{ current == slug ? ' active' }}" href="{{ path('admin_list', {section: slug}) }}"><i class="bi {{ s.icon }}"></i><span>{{ s.label }}</span></a>
        {% endfor %}
      </div>
    </nav>
    <div class="sidebar__bottom">
      <div class="sidebar-user">
        <div class="sidebar-user__avatar"><i class="bi bi-person-fill"></i></div>
        <div class="sidebar-user__meta">
          <span class="sidebar-user-name">{{ app.user.name|default('Admin') }}</span>
          <span class="sidebar-user-email">{{ app.user.userIdentifier }}</span>
        </div>
      </div>
      <a href="{{ path('admin_logout') }}" class="sidebar-user__logout" title="Déconnexion"><i class="bi bi-box-arrow-right"></i></a>
    </div>
  </aside>
  <div class="sidebar-overlay"></div>

  <div class="main-wrap">
    <header class="topbar">
      <div class="topbar__left">
        <button class="mobile-toggle" aria-label="Menu"><i class="bi bi-list"></i></button>
        <span class="topbar-title">{{ block('title') }}</span>
      </div>
    </header>
    <main class="content">
      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="flash flash--{{ type }}"><i class="bi {{ type == 'error' ? 'bi-exclamation-triangle' : 'bi-check-circle' }}"></i> {{ message }}</div>
        {% endfor %}
      {% endfor %}
      <section class="content-section active">
        {% block content %}{% endblock %}
      </section>
    </main>
  </div>
</div>
<script>
  // Menu mobile + confirmation avant suppression
  const toggleMenu = (open) => ['.sidebar', '.sidebar-overlay'].forEach(s => document.querySelector(s)?.classList.toggle('open', open));
  document.querySelector('.mobile-toggle')?.addEventListener('click', () => toggleMenu(!document.querySelector('.sidebar').classList.contains('open')));
  document.querySelector('.sidebar-overlay')?.addEventListener('click', () => toggleMenu(false));
  document.querySelectorAll('form[data-confirm]').forEach(f => f.addEventListener('submit', e => { if (!confirm(f.dataset.confirm)) e.preventDefault(); }));
  document.querySelectorAll('.flash').forEach(el => setTimeout(() => el.classList.add('flash--hide'), 4000));
</script>
{% if app.request.attributes.get('_route') in ['admin_new', 'admin_edit', 'admin_portfolio'] %}
<script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
<script>
  // Éditeur de texte riche (Markdown) : même rendu que sur le site public
  // data-md="inline" : texte court affiché dans une carte (pas de titres ni de listes)
  const INLINE_TOOLBAR = [
    { name: 'bold', action: EasyMDE.toggleBold, className: 'fa fa-bold', title: 'Gras' },
    { name: 'italic', action: EasyMDE.toggleItalic, className: 'fa fa-italic', title: 'Italique' },
    { name: 'code', action: EasyMDE.toggleCodeBlock, className: 'fa fa-code', title: 'Code' },
    { name: 'link', action: EasyMDE.drawLink, className: 'fa fa-link', title: 'Lien' },
    '|',
    { name: 'preview', action: EasyMDE.togglePreview, className: 'fa fa-eye no-disable', title: 'Aperçu' },
    '|',
    { name: 'undo', action: EasyMDE.undo, className: 'fa fa-undo', title: 'Annuler' },
    { name: 'redo', action: EasyMDE.redo, className: 'fa fa-repeat', title: 'Rétablir' },
  ];
  document.querySelectorAll('textarea.markdown-editor').forEach((el) => {
    const inline = el.dataset.md === 'inline';
    const isLong = !el.dataset.md;
    const editor = new EasyMDE({
      element: el,
      spellChecker: false,
      nativeSpellcheck: true,
      status: inline ? ['words'] : ['lines', 'words'],
      minHeight: isLong ? '220px' : (inline ? '70px' : '120px'),
      placeholder: isLong ? 'Contexte, objectifs, ce que tu as fait, résultats…' : '',
      toolbar: inline ? INLINE_TOOLBAR : [
        { name: 'heading-2', action: EasyMDE.toggleHeading2, className: 'fa fa-header', title: 'Titre' },
        { name: 'heading-3', action: EasyMDE.toggleHeading3, className: 'fa fa-header fa-header-x fa-header-3', title: 'Sous-titre' },
        '|',
        { name: 'bold', action: EasyMDE.toggleBold, className: 'fa fa-bold', title: 'Gras' },
        { name: 'italic', action: EasyMDE.toggleItalic, className: 'fa fa-italic', title: 'Italique' },
        { name: 'code', action: EasyMDE.toggleCodeBlock, className: 'fa fa-code', title: 'Code' },
        '|',
        { name: 'unordered-list', action: EasyMDE.toggleUnorderedList, className: 'fa fa-list-ul', title: 'Liste à puces' },
        { name: 'ordered-list', action: EasyMDE.toggleOrderedList, className: 'fa fa-list-ol', title: 'Liste numérotée' },
        { name: 'quote', action: EasyMDE.toggleBlockquote, className: 'fa fa-quote-left', title: 'Citation' },
        '|',
        { name: 'link', action: EasyMDE.drawLink, className: 'fa fa-link', title: 'Lien' },
        { name: 'table', action: EasyMDE.drawTable, className: 'fa fa-table', title: 'Tableau' },
        { name: 'horizontal-rule', action: EasyMDE.drawHorizontalRule, className: 'fa fa-minus', title: 'Séparateur' },
        '|',
        { name: 'preview', action: EasyMDE.togglePreview, className: 'fa fa-eye no-disable', title: 'Aperçu' },
        { name: 'side-by-side', action: EasyMDE.toggleSideBySide, className: 'fa fa-columns no-disable no-mobile', title: 'Côte à côte' },
        { name: 'fullscreen', action: EasyMDE.toggleFullScreen, className: 'fa fa-arrows-alt no-disable no-mobile', title: 'Plein écran' },
        '|',
        { name: 'undo', action: EasyMDE.undo, className: 'fa fa-undo', title: 'Annuler' },
        { name: 'redo', action: EasyMDE.redo, className: 'fa fa-repeat', title: 'Rétablir' },
      ],
    });
    // Le formulaire lit le textarea : on le synchronise avant l'envoi
    el.form?.addEventListener('submit', () => { el.value = editor.value(); });
  });
</script>
{% endif %}
{% endblock %}
</body>
</html>
