{% extends 'admin/base.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% set isNew = item.id is null %}
{% block title %}{{ isNew ? conf.new : conf.label ~ ' — modifier' }}{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <a class="back-link" href="{{ path('admin_list', {section: section}) }}"><i class="bi bi-arrow-left"></i> {{ conf.label }}</a>
    <h1 class="page-head__title">{{ isNew ? conf.new : (item.title ?? item.name ?? item.label ?? 'Modifier') }}</h1>
  </div>
  {% if not isNew and conf.public is defined %}
    <a class="btn btn--outline" href="{{ path(conf.public, {id: item.id}) }}" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Voir sur le site</a>
  {% endif %}
</div>

{{ form_start(form, {attr: {class: 'card admin-form', novalidate: 'novalidate'}}) }}
  <div class="card__head"><h2><i class="bi {{ conf.icon }}"></i> Informations</h2></div>
  <div class="card__body">
    {{ form_errors(form) }}
    {% for child in form %}
      {% if child.vars.name starts with 'upload_' %}
        {% set prop = child.vars.name|slice(7) %}
        {% set current = attribute(item, prop) %}
        <div class="file-block">
          {% if current %}
            <div class="file-current">
              {% if admin_is_image(current) %}
                <img src="{{ current }}" alt="">
              {% else %}
                <a href="{{ current }}" target="_blank" class="btn btn--sm btn--outline"><i class="bi bi-file-earmark-pdf"></i> Voir le fichier actuel</a>
              {% endif %}
            </div>
          {% endif %}
          <div class="file-fields">
            {{ form_row(child, {label: child.vars.label ~ (current ? ' — remplacer' : '')}) }}
            {% if form['remove_' ~ prop] is defined %}{{ form_row(form['remove_' ~ prop]) }}{% endif %}
          </div>
        </div>
      {% elseif not (child.vars.name starts with 'remove_') and child.vars.name != '_token' %}
        {{ form_row(child) }}
      {% endif %}
    {% endfor %}
  </div>
  <div class="card__foot form-actions">
    <a class="btn btn--ghost" href="{{ path('admin_list', {section: section}) }}">Annuler</a>
    <button type="submit" class="btn btn--primary"><i class="bi bi-check-lg"></i> {{ isNew ? 'Créer' : 'Enregistrer' }}</button>
  </div>
{{ form_end(form) }}

{% if conf.gallery is defined %}
  <div class="card" id="galerie">
    <div class="card__head"><h2><i class="bi bi-images"></i> Galerie d'images</h2></div>
    <div class="card__body">
      {% if isNew %}
        <p class="field-hint"><i class="bi bi-info-circle"></i> Enregistrez d'abord l'élément, puis ajoutez ses images ici.</p>
      {% else %}
        <form method="post" enctype="multipart/form-data" action="{{ path('admin_gallery_upload', {section: section, id: item.id}) }}" class="dropzone-form">
          <input type="hidden" name="_token" value="{{ csrf_token('gallery' ~ section ~ item.id) }}">
          <label class="dropzone">
            <input type="file" name="images[]" multiple accept="image/*" onchange="this.form.submit()">
            <span class="dropzone__icon"><i class="bi bi-cloud-arrow-up"></i></span>
            <span class="dropzone__title">Cliquez ou déposez des images ici</span>
            <span class="dropzone__sub">JPG, PNG, GIF, WEBP, SVG — 5 Mo max par image — plusieurs à la fois</span>
          </label>
        </form>

        {% if item.images|length %}
          <form method="post" action="{{ path('admin_gallery_save', {section: section, id: item.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('gallery' ~ section ~ item.id) }}">
            <div class="gallery-grid">
              {% for img in item.images %}
                <div class="gallery-card">
                  <a href="{{ img.imageUrl }}" target="_blank" class="gallery-card__img"><img src="{{ img.imageUrl }}" alt="{{ img.caption }}"></a>
                  <div class="gallery-card__body">
                    <input class="field-input" name="img[{{ img.id }}][caption]" value="{{ img.caption }}" placeholder="Légende">
                    <textarea class="field-input field-textarea" name="img[{{ img.id }}][description]" rows="2" placeholder="Description (optionnel)">{{ img.description }}</textarea>
                    <div class="gallery-card__row">
                      <label>Ordre <input class="field-input order-input" type="number" name="img[{{ img.id }}][order]" value="{{ img.order }}"></label>
                      <label class="check-inline danger"><input type="checkbox" name="img[{{ img.id }}][delete]" value="1"> Supprimer</label>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn--primary"><i class="bi bi-check-lg"></i> Enregistrer la galerie</button>
            </div>
          </form>
        {% else %}
          <p class="field-hint">Aucune image pour l'instant.</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endif %}

{% if not isNew %}
  <form method="post" action="{{ path('admin_delete', {section: section, id: item.id}) }}" data-confirm="Supprimer définitivement cet élément{{ conf.gallery is defined ? ' et ses images' }} ?" class="danger-zone">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ section ~ item.id) }}">
    <button class="btn btn--danger-outline"><i class="bi bi-trash"></i> Supprimer cet élément</button>
  </form>
{% endif %}
{% endblock %}
