<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% set fullname = owner ? owner.first_name ~ ' ' ~ owner.last_name : 'Portfolio' %}
    {% include 'site/_seo.html.twig' with {
      seo_title: item.title ~ ' — ' ~ fullname,
      seo_description: item.description ?? '',
      seo_image: (item.images ?? [])|first ? ((item.images|first).image_url) : (owner.photo_url ?? null),
      seo_type: 'article',
      seo_author: fullname
    } %}
    <link rel="stylesheet" href="{{ asset('site/styles.css') }}" />
    <link rel="stylesheet" href="{{ asset('site/realisation/styles.css') }}" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,600&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Navbar -->
    <nav id="navbar" class="scrolled">
      <div class="nav-container">
        <a href="{{ path('home') }}" id="logo">
          {{ owner.first_name ?? 'Portfolio' }} <span class="logo-italic">{{ owner.last_name ?? '' }}</span>
        </a>
        <ul class="nav-links">
          <li>
            <a href="{{ path('home') }}" class="nav-link"
              >Accueil<span class="nav-underline"></span
            ></a>
          </li>
          <li>
            <a href="{{ path('home') }}#profil" class="nav-link"
              >Profil<span class="nav-underline"></span
            ></a>
          </li>
          <li>
            <a href="{{ path('home') }}#realisations" class="nav-link"
              >Projets<span class="nav-underline"></span
            ></a>
          </li>
          <li>
            <a href="{{ path('home') }}#contact" class="nav-cta">Me contacter</a>
          </li>
        </ul>
        <button id="hamburger" aria-label="Toggle menu">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
      <div id="mobile-menu" class="hidden">
        <a href="{{ path('home') }}" class="nav-mobile-link">Accueil</a>
        <a href="{{ path('home') }}#profil" class="nav-mobile-link">Profil</a>
        <a href="{{ path('home') }}#realisations" class="nav-mobile-link">Projets</a>
        <a href="{{ path('home') }}#contact" class="nav-mobile-link">Me contacter</a>
      </div>
    </nav>

    <!-- Contenu de la réalisation -->
    <main class="detail-page">
      <div class="detail-container">
        <!-- Bouton retour -->
        <a href="{{ path('home') }}#realisations" class="back-button">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Retour aux réalisations
        </a>

        <!-- Contenu principal -->
        <div id="realisation-content" class="detail-content">
          <!-- Chargé dynamiquement -->
        </div>
      </div>
    </main>

    <!-- Loading overlay -->
    <div id="loading-overlay">
      <div class="loader-container">
        <div class="loader-spinner">
          <div class="spinner-ring"></div>
          <div class="spinner-ring"></div>
          <div class="spinner-ring"></div>
          <div class="spinner-dot"></div>
        </div>
        <div class="loader-text">
          <p id="loader-status" class="loader-status">
            Chargement de la réalisation...
          </p>
          <p id="loader-tip" class="loader-tip">Récupération des détails</p>
        </div>
        <div class="loader-progress">
          <div id="loader-progress-bar" class="loader-progress-bar"></div>
        </div>
      </div>
    </div>

    <script>window.SITE_OWNER = {{ fullname|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }};</script>
    <script>window.DETAIL_DATA = {{ item|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }};</script>
    <script src="{{ asset('site/realisation/script.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js"></script>
  </body>
</html>
